{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Security Baseline Add-on (SecureBoot, lockdown, sshd, shadow, auditd)",
    "id": {
      "group": null,
      "name": "TA-baseline",
      "version": "1.0.1"
    },
    "author": [{"name":"Michael \"JKat54\" Bentley","email":"michael@bentleypc.com","company":"BentleyPC LLC"}],
    "releaseDate": "11/16/2026",
    "description": "Collects a host security baseline from the kernel/filesystem: UEFI SecureBoot state, kernel lockdown mode, SSH root-login and password-auth settings (sshd_config, including sshd.d), password aging policy (/etc/shadow), and auditd service state. Emits JSON events to index=main (sourcetype baseline:status) and baseline.* metrics to index=metrics (sourcetype baseline:metrics) hourly, with dashboards.",
